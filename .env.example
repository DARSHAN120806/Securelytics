# Copy to .env and fill in. Never commit .env (it is git-ignored).
EVENTS_PER_SEC=50              # replay speed of fraudTest.csv
ATTACK_EVERY_SEC=60            # inject a synthetic card-testing attack every N seconds (0 = off)
SHADOW_SCORING=true            # score every transaction with all models for live comparison

ADMIN_PASSWORD=change-me       # admin panel + API model switching (required for the admin panel)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me    # local database password
